# FastAPI backend origin. Leave unset to use the built-in Vite mock API, which
# serves the same contract (including /auth) on the dev server's own origin.
VITE_API_BASE_URL=http://localhost:8000

# Path prefix the API is reached under.
#
# The backend mounts everything at the root — /machines, not /api/machines — so
# a direct connection sets this empty. In production the SPA and the API share
# an origin and Traefik routes /api onward, which is the default when unset.
# The mock API is served under whatever this says, so it must be non-empty
# (use /api) when VITE_API_BASE_URL is unset.
VITE_API_PREFIX=
